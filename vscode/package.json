{
  "name": "pearls",
  "displayName": "Pearls",
  "description": "VS Code extension for 6502 assembly, powered by merls",
  "version": "4.2.0",
  "publisher": "razdolbai",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/razdolbai/merls.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:6502",
    "onCommand:pearls.compileCurrentFile",
    "onCommand:pearls.compileProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[6502]": {
        "editor.indentSize": 8,
        "editor.tabSize": 8,
        "editor.quickSuggestions": true
      }
    },
    "commands": [
      {
        "command": "pearls.compileCurrentFile",
        "title": "Compile Current File with Merlin32",
        "category": "Pearls"
      },
      {
        "command": "pearls.compileProject",
        "title": "Assemble Project with Merlin32",
        "category": "Pearls"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pearls.compileCurrentFile",
          "when": "resourceLangId == 6502",
          "group": "navigation@10"
        },
        {
          "command": "pearls.compileProject",
          "when": "resourceLangId == 6502",
          "group": "navigation@11"
        }
      ],
      "editor/context": [
        {
          "command": "pearls.compileCurrentFile",
          "when": "resourceLangId == 6502",
          "group": "navigation"
        },
        {
          "command": "pearls.compileProject",
          "when": "resourceLangId == 6502",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pearls",
      "properties": {
        "pearls.merlin32Executable": {
          "type": "string",
          "default": "merlin32",
          "description": "Command or absolute path for the merlin32 assembler executable used by the Pearls compile command."
        },
        "pearls.compileArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments to pass to merlin32 before the macro folder and current file path when using the Pearls compile command."
        },
        "pearls.merlin32MacroFolder": {
          "type": "string",
          "default": "",
          "description": "Optional per-project macro folder path passed to merlin32. When unset, Pearls uses the current file's directory."
        },
        "pearls.merlin32ProjectEntryFile": {
          "type": "string",
          "default": "",
          "description": "Project entry file or link script for the Pearls project assembly command. Relative paths are resolved from the workspace folder."
        }
      }
    },
    "languages": [
      {
        "id": "6502",
        "aliases": [
          "6502 Assembly",
          "merlin32"
        ],
        "extensions": [
          ".s",
          ".S",
          ".asm"
        ],
        "configuration": "./language-configuration.json",
        "semanticHighlighting": true
      }
    ],
    "grammars": [
      {
        "language": "6502",
        "scopeName": "source.6502",
        "path": "./syntaxes/6502.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/**/*.test.js"
  },
  "dependencies": {
    "@razdolbai/merls": "^4.1.37",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.91.0",
    "typescript": "^5.0.0"
  }
}
