{
  "name": "pearls",
  "displayName": "Pearls",
  "description": "VS Code extension for 6502 assembly, powered by merls",
  "version": "2.0.1",
  "publisher": "razdolbai",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/razdolbai/merls.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:6502"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "macro": "#C586C0",
          "function": "#DCDCAA",
          "variable": "#9CDCFE"
        }
      }
    },
    "languages": [
      {
        "id": "6502",
        "aliases": [
          "6502 Assembly",
          "merlin32"
        ],
        "extensions": [
          ".s",
          ".S",
          ".asm"
        ],
        "configuration": "./language-configuration.json",
        "semanticHighlighting": true
      }
    ],
    "grammars": [
      {
        "language": "6502",
        "scopeName": "source.6502",
        "path": "./syntaxes/6502.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@razdolbai/merls": "^2.1.6",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
