{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build language server",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "${workspaceFolder}/..",
        "run",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "watch extension",
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "dependsOn": [
        "build language server"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
